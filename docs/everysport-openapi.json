{
  "components": {
    "schemas": {
      "ttab.everysport.CategoryConfig": {
        "description": "CategoryConfig is an Everysport competition category. The category tier carries no import settings, it only groups competitions under a sport.",
        "properties": {
          "comment": {
            "description": "Comment is a free text note for whoever configures the import.",
            "type": "string"
          },
          "gender": {
            "description": "Gender is the gender category slug, if any.",
            "type": "string"
          },
          "id": {
            "description": "ID is the Everysport competition category ID.",
            "type": "integer"
          },
          "name": {
            "description": "Name is the Everysport category name.",
            "type": "string"
          },
          "seen": {
            "description": "Seen is when the category was last listed by Everysport, as RFC3339.",
            "type": "string"
          },
          "sport_id": {
            "description": "SportID is the Everysport ID of the sport the category belongs to.",
            "type": "integer"
          },
          "updated": {
            "description": "Updated is when the comment last changed, as RFC3339.",
            "type": "string"
          },
          "updated_by": {
            "description": "UpdatedBy is the subject that last changed the comment.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ttab.everysport.CompetitionConfig": {
        "description": "CompetitionConfig is the import configuration for an Everysport competition. Competitions are identified by their static ID, the competition ID changes between seasons.",
        "properties": {
          "category_id": {
            "description": "CategoryID is the Everysport ID of the competition category.",
            "type": "integer"
          },
          "competition_id": {
            "description": "CompetitionID is the Everysport competition ID we saw last.",
            "type": "integer"
          },
          "full_name": {
            "description": "FullName is the full Everysport competition name.",
            "type": "string"
          },
          "gender": {
            "description": "Gender is the gender category slug, if any.",
            "type": "string"
          },
          "name": {
            "description": "Name is the Everysport competition name.",
            "type": "string"
          },
          "seen": {
            "description": "Seen is when the competition was last listed by Everysport, as RFC3339.",
            "type": "string"
          },
          "settings": {
            "$ref": "#/components/schemas/ttab.everysport.ImportSettings"
          },
          "sport_id": {
            "description": "SportID is the Everysport ID of the sport the competition belongs to.",
            "type": "integer"
          },
          "static_id": {
            "description": "StaticID is the Everysport static ID of the competition.",
            "type": "integer"
          },
          "updated": {
            "description": "Updated is when the settings last changed, as RFC3339.",
            "type": "string"
          },
          "updated_by": {
            "description": "UpdatedBy is the subject that last changed the settings.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ttab.everysport.ConfigState": {
        "description": "ConfigState is the review state of a configuration entry. Entries that the service discovers on its own start out as pending.",
        "enum": [
          "STATE_UNSPECIFIED",
          "STATE_PENDING",
          "STATE_ENABLED",
          "STATE_DISABLED"
        ],
        "type": "string"
      },
      "ttab.everysport.ConfigWarning": {
        "description": "ConfigWarning is a problem with a configuration entry that doesn't stop it from being saved.",
        "properties": {
          "code": {
            "description": "Code identifies the kind of problem, f.ex. \"unresolved_sport_name\".",
            "type": "string"
          },
          "field": {
            "description": "Field is the name of the offending settings field.",
            "type": "string"
          },
          "message": {
            "description": "Message is a human readable description of the problem.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ttab.everysport.ExportConfigRequest": {
        "type": "object"
      },
      "ttab.everysport.ExportConfigResponse": {
        "properties": {
          "csv": {
            "description": "CSV is the full configuration as a CSV file.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ttab.everysport.GetCompetitionRequest": {
        "properties": {
          "sport_id": {
            "description": "SportID is the Everysport sport ID. Required.",
            "type": "integer"
          },
          "static_id": {
            "description": "StaticID is the Everysport competition static ID. Required.",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ttab.everysport.GetCompetitionResponse": {
        "properties": {
          "competition": {
            "$ref": "#/components/schemas/ttab.everysport.CompetitionConfig"
          }
        },
        "type": "object"
      },
      "ttab.everysport.GetSportRequest": {
        "properties": {
          "id": {
            "description": "ID is the Everysport sport ID. Required.",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ttab.everysport.GetSportResponse": {
        "properties": {
          "sport": {
            "$ref": "#/components/schemas/ttab.everysport.SportConfig"
          }
        },
        "type": "object"
      },
      "ttab.everysport.ImportSettings": {
        "description": "ImportSettings is the editable part of a sport or competition configuration. All other fields identify the entry and are read only.",
        "properties": {
          "comment": {
            "description": "Comment is a free text note for whoever configures the import.",
            "type": "string"
          },
          "merge_events": {
            "description": "MergeEvents controls whether several calendar entries for the same day are merged into a single event document.",
            "type": "boolean"
          },
          "merge_setting": {
            "description": "MergeSetting is the strategy used to group entries into events, either \"CategoryMerge\" or \"CompetitionMerge\". Empty means that a competition uses the strategy of its sport, and that a sport uses \"CategoryMerge\".",
            "type": "string"
          },
          "newsvalue": {
            "description": "Newsvalue is the value of the core/newsvalue block of created events, 1 to 5. Required when enabling an entry.",
            "type": "integer"
          },
          "sport": {
            "description": "Sport is the list of TT media topic names that events are linked to through core/category links, in addition to the generic \"Sport\" topic. Empty means that a competition uses the topics of its sport, and that a sport uses its own name.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "state": {
            "$ref": "#/components/schemas/ttab.everysport.ConfigState"
          }
        },
        "type": "object"
      },
      "ttab.everysport.ListCategoriesRequest": {
        "properties": {
          "sport_id": {
            "description": "SportID is the sport to list categories for. Required.",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ttab.everysport.ListCategoriesResponse": {
        "properties": {
          "categories": {
            "description": "Categories are the categories of the sport, ordered by name.",
            "items": {
              "$ref": "#/components/schemas/ttab.everysport.CategoryConfig"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "ttab.everysport.ListCompetitionsRequest": {
        "properties": {
          "category_id": {
            "description": "CategoryID only returns competitions in the given category. Optional.",
            "type": "integer"
          },
          "limit": {
            "description": "Limit is the maximum number of competitions to return. Optional.",
            "type": "integer"
          },
          "offset": {
            "description": "Offset is the number of competitions to skip. Optional.",
            "type": "integer"
          },
          "query": {
            "description": "Query only returns competitions whose name matches. Optional.",
            "type": "string"
          },
          "sport_id": {
            "description": "SportID only returns competitions for the given sport. Optional.",
            "type": "integer"
          },
          "stale": {
            "description": "Stale only returns competitions that Everysport no longer lists.",
            "type": "boolean"
          },
          "state": {
            "$ref": "#/components/schemas/ttab.everysport.ConfigState"
          }
        },
        "type": "object"
      },
      "ttab.everysport.ListCompetitionsResponse": {
        "properties": {
          "competitions": {
            "description": "Competitions are the matching competitions, ordered by name.",
            "items": {
              "$ref": "#/components/schemas/ttab.everysport.CompetitionConfig"
            },
            "type": "array"
          },
          "total": {
            "description": "Total is the number of competitions that match, ignoring offset and limit.",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ttab.everysport.ListSportsRequest": {
        "properties": {
          "query": {
            "description": "Query only returns sports whose name matches. Optional.",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/ttab.everysport.ConfigState"
          }
        },
        "type": "object"
      },
      "ttab.everysport.ListSportsResponse": {
        "properties": {
          "sports": {
            "description": "Sports are the matching sports, ordered by name.",
            "items": {
              "$ref": "#/components/schemas/ttab.everysport.SportConfig"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "ttab.everysport.ManualImportRequest": {
        "properties": {
          "category": {
            "description": "Category only re-imports the events with the specific category.",
            "type": "integer"
          },
          "competition": {
            "description": "Category only re-imports the events for the specific competition static ID.",
            "type": "integer"
          },
          "force": {
            "description": "Force overwrite of calendar entries.",
            "type": "boolean"
          },
          "from_date": {
            "description": "FromDate is the date from which to fetch events for import. Optional, defaults to today.",
            "type": "string"
          },
          "to_date": {
            "description": "FromDate is the last date we should get events for. Optional.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ttab.everysport.ManualImportResponse": {
        "properties": {
          "queued_imports": {
            "description": "QueuedImports is the total numer of events that were queued for import.",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ttab.everysport.SportConfig": {
        "description": "SportConfig is the import configuration for an Everysport sport.",
        "properties": {
          "id": {
            "description": "ID is the Everysport sport ID.",
            "type": "integer"
          },
          "name": {
            "description": "Name is the Everysport sport name.",
            "type": "string"
          },
          "pending_competitions": {
            "description": "PendingCompetitions is the number of competitions of the sport that are awaiting review.",
            "type": "integer"
          },
          "seen": {
            "description": "Seen is when the sport was last listed by Everysport, as RFC3339.",
            "type": "string"
          },
          "settings": {
            "$ref": "#/components/schemas/ttab.everysport.ImportSettings"
          },
          "slug": {
            "description": "Slug is the Everysport sport slug.",
            "type": "string"
          },
          "updated": {
            "description": "Updated is when the settings last changed, as RFC3339.",
            "type": "string"
          },
          "updated_by": {
            "description": "UpdatedBy is the subject that last changed the settings.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ttab.everysport.UpdateCategoryRequest": {
        "properties": {
          "comment": {
            "description": "Comment replaces the current comment of the category.",
            "type": "string"
          },
          "id": {
            "description": "ID is the Everysport competition category ID. Required.",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ttab.everysport.UpdateCategoryResponse": {
        "properties": {
          "category": {
            "$ref": "#/components/schemas/ttab.everysport.CategoryConfig"
          }
        },
        "type": "object"
      },
      "ttab.everysport.UpdateCompetitionRequest": {
        "properties": {
          "settings": {
            "$ref": "#/components/schemas/ttab.everysport.ImportSettings"
          },
          "sport_id": {
            "description": "SportID is the Everysport sport ID. Required.",
            "type": "integer"
          },
          "static_id": {
            "description": "StaticID is the Everysport competition static ID. Required.",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ttab.everysport.UpdateCompetitionResponse": {
        "properties": {
          "competition": {
            "$ref": "#/components/schemas/ttab.everysport.CompetitionConfig"
          },
          "warnings": {
            "description": "Warnings are problems with the saved settings.",
            "items": {
              "$ref": "#/components/schemas/ttab.everysport.ConfigWarning"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "ttab.everysport.UpdateSportRequest": {
        "properties": {
          "id": {
            "description": "ID is the Everysport sport ID. Required.",
            "type": "integer"
          },
          "settings": {
            "$ref": "#/components/schemas/ttab.everysport.ImportSettings"
          }
        },
        "type": "object"
      },
      "ttab.everysport.UpdateSportResponse": {
        "properties": {
          "sport": {
            "$ref": "#/components/schemas/ttab.everysport.SportConfig"
          },
          "warnings": {
            "description": "Warnings are problems with the saved settings.",
            "items": {
              "$ref": "#/components/schemas/ttab.everysport.ConfigWarning"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
